[Unit]
Description=UFI USB Gadget Configuration
After=NetworkManager.service systemd-networkd.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="GC_MODE=rndis,ffs"
ExecStart=/usr/sbin/ufi-usb-manager.sh startup
Restart=no
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target