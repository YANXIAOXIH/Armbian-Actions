[Unit]
Description=UFI USB Gadget
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="GC_MODE=ncm,ffs"
ExecStart=/usr/sbin/ufi-usb-manager.sh startup
Restart=no
TimeoutStartSec=120s
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target